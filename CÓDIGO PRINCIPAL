create database locacao;


use locacao;


create table cliente_contato (
    telefone_cliente varchar(12) primary key,
    status_contato tinyint not null
);


create table cliente (
    cpf_cliente varchar(11) primary key,
    telefone_cliente varchar(12) not null,
    nome_cliente varchar(100) not null,
    email_cliente varchar(30) unique not null,
    cnh_cliente varchar(11) unique not null,
    foreign key (telefone_cliente) references cliente_contato (telefone_cliente)
    on delete no action
    on update no action
);


create table modelo (
    modelo varchar(25) not null,
    marca varchar(25) not null,
    primary key (modelo, marca)
);


create table categoria (
    id_categoria int primary key auto_increment,
    nome varchar(20) unique not null
);


create table veiculo (
    placa varchar(7) primary key not null,
    modelo varchar(25) not null,
    marca varchar(25) not null,
    valor_diaria decimal(10,2) not null,
    ano year not null,
    status_veiculo tinyint not null,
    id_categoria int not null,
    foreign key (modelo, marca) references modelo (modelo, marca)
    on delete no action
    on update no action,
    foreign key (id_categoria) references categoria (id_categoria)
    on delete no action
    on update no action
);


create table aluguel (
    id_aluguel int primary key auto_increment,
    placa varchar(7) not null,
    valor decimal(10,2) not null,
    data_inicio datetime not null,
    data_fim datetime not null,
    status_aluguel tinyint not null,
    cpf_cliente varchar(11) not null,
    foreign key (placa) references veiculo (placa)
    on delete no action
    on update no action,
    foreign key (cpf_cliente) references cliente (cpf_cliente)
    on delete no action
    on update no action
);


create table agendamento (
    id_agendamento int primary key auto_increment,
    cpf_cliente varchar(11) not null,
    status_agendamento tinyint not null,
    duracao time not null,
    data_agendamento date not null,
    horario time not null,
    placa varchar(7),
    foreign key (cpf_cliente) references cliente (cpf_cliente)
    on delete no action
    on update no action,
    foreign key (placa) references veiculo (placa)
    on delete no action
    on update no action
);


create table manutencao (
    id_manutencao int primary key auto_increment,
    placa varchar(7) not null,
    custo decimal(10,2) not null,
    descricao varchar(120) not null,
    tipo varchar(15) not null,
    data_manutencao datetime not null,
    foreign key (placa) references veiculo (placa)
    on delete no action
    on update no action
);


create table pagamento (
    id_pagamento int primary key auto_increment,
    id_aluguel int not null,
    metodo varchar(15) not null,
    status_pagamento tinyint not null,
    valor decimal(10,2) not null,
    data_pagamento datetime not null,
    foreign key (id_aluguel) references aluguel (id_aluguel)
    on delete no action
    on update no action
);
